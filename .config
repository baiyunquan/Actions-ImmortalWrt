CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-cp-02=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_USE_APK=y

# Keep the NOR image independently bootable and able to activate extroot.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_firewall4=y

# Build the complete SD/extroot application set as APK modules. The workflow
# promotes these packages to built-in only while assembling the rich rootfs.
CONFIG_PACKAGE_luci-app-firewall=m
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=m

CONFIG_PACKAGE_filebrowser=m
CONFIG_PACKAGE_luci-app-filebrowser=m
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=m

CONFIG_PACKAGE_luci-app-argon-config=m
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=m
CONFIG_PACKAGE_luci-app-package-manager=m
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=m
CONFIG_PACKAGE_luci-app-ttyd=m
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=m
CONFIG_PACKAGE_luci-app-homeproxy=m
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=m
CONFIG_PACKAGE_luci-proto-wireguard=m
CONFIG_PACKAGE_luci-app-tailscale-community=m
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=m
CONFIG_PACKAGE_luci-app-vlmcsd=m
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=m
CONFIG_PACKAGE_luci-app-samba4=m

CONFIG_PACKAGE_qbittorrent=m
CONFIG_PACKAGE_luci-app-qbittorrent=m
CONFIG_PACKAGE_luci-i18n-qbittorrent-zh-cn=m

CONFIG_PACKAGE_ip-full=m
CONFIG_PACKAGE_kmod-dummy=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-nft-socket=m
CONFIG_PACKAGE_kmod-nft-tproxy=m
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_yq=m
CONFIG_PACKAGE_mihomo-meta=m
CONFIG_PACKAGE_nikki=m
CONFIG_PACKAGE_luci-app-nikki=m
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=m
